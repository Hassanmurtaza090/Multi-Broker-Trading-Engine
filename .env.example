# =============================================================================
# Multi-Broker Trading Engine — Environment Template
#
# Copy this file to `.env` and fill in values for your environment.
# NEVER commit a `.env` file containing real secrets.
# All values below are placeholders only.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=multi-broker-trading-engine

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_engine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_engine

# --- API ---
# Bind address: 127.0.0.1 for bare-metal dev runs; the backend container
# defaults to 0.0.0.0 (the compose network is the isolation boundary).
API_HOST=127.0.0.1
API_PORT=8000
API_ORIGINS=http://localhost:5173
# Enable the OpenAPI/docs endpoints (dev tooling). OFF is the secure default (M14);
# main.py additionally auto-enables them when APP_ENV=development.
API_DOCS_ENABLED=false
# Loopback bind defaults for Docker (M14): public exposure arrives with the
# M15 reverse proxy, never by accident.
API_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1

# --- Logging (M15) ----------------------------------
# "text" (dev) or "json" (production log aggregation).
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- Persistence (M15) ------------------------------------------------
# Order repository: "memory" (dev/tests) or "postgres" (production).
ORDER_REPOSITORY=memory
# SQLAlchemy async URL (required when ORDER_REPOSITORY=postgres).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_engine

# --- Broker composition (M15) --------------------------------------------
# Which simulated adapter to bind (real transports deferred per ADR-014/015)
# and the internal account the runtime serves.
BROKER_ADAPTER=IBKR
BROKER_ACCOUNT=ACC-001

# --- Production proxy (docker-compose.prod.yml, M15) -----------------------
# Host port for the TLS edge and the mounted certificate directory.
HTTPS_PORT=8443
# TLS_CERT_DIR=./infrastructure/nginx/certs   # gitignored; staging: scripts/generate_tls_certs.*

# --- Redis / Pub-Sub ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication / JWT (M12) ---
# HMAC-SHA256 signing secret — MUST be >= 32 bytes in production (RFC 7518).
# If left EMPTY in development, the backend generates an EPHEMERAL secret at
# startup (sessions die with the process; the secret is never logged).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Identity sources (M12) ---
# JSON users file (records with PBKDF2 password hashes; see
# scripts/hash_password.py). NEVER commit user files.
#   [{"username":"alice","password_hash":"pbkdf2_sha256$...","roles":["trader"],"accounts":["ACC-001"]}]
AUTH_USERS_FILE=
# Dev-convenience demo users: passwords come from the environment (this
# gitignored file), are hashed at startup, and are never stored raw.
AUTH_DEMO_TRADER_USERNAME=trader
AUTH_DEMO_TRADER_PASSWORD=
AUTH_DEMO_TRADER_ACCOUNTS=ACC-001
AUTH_DEMO_ADMIN_USERNAME=admin
AUTH_DEMO_ADMIN_PASSWORD=
AUTH_DEMO_ADMIN_ACCOUNTS=*
# Login throttling (M14): failures per username+IP within the window before
# HTTP 429 Retry-After (fail-closed — a locked key stays locked even for
# the correct password until the window slides).
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=60

# --- Interactive Brokers (IBKR) ---
# Placeholders only. Real credentials must never be committed.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
IBKR_PAPER=true
IBKR_TWS_VERSION=

# --- Saxo Bank ---
# Placeholders only. Real credentials must never be committed.
SAXO_ENV=sim  # sim | live
SAXO_API_BASE_URL=
SAXO_CLIENT_ID=
SAXO_CLIENT_SECRET=
SAXO_REDIRECT_URI=
SAXO_TOKEN=

# --- Logging ---
LOG_LEVEL=INFO