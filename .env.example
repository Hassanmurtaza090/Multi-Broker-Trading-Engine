# =============================================================================
# Multi-Broker Trading Engine — Environment Template
#
# Copy this file to `.env` and fill in values for your environment.
# NEVER commit a `.env` file containing real secrets.
# All values below are placeholders only.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=multi-broker-trading-engine

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_engine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_engine

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_ORIGINS=http://localhost:5173

# --- Redis / Pub-Sub ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication / JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Interactive Brokers (IBKR) ---
# Placeholders only. Real credentials must never be committed.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
IBKR_PAPER=true
IBKR_TWS_VERSION=

# --- Saxo Bank ---
# Placeholders only. Real credentials must never be committed.
SAXO_ENV=sim  # sim | live
SAXO_API_BASE_URL=
SAXO_CLIENT_ID=
SAXO_CLIENT_SECRET=
SAXO_REDIRECT_URI=
SAXO_TOKEN=

# --- Logging ---
LOG_LEVEL=INFO